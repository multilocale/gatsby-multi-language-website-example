{
  "name": "gatsby-multi-language-website-example",
  "version": "2.0.0",
  "private": true,
  "description": "Multi-language Gatsby website whose translations are managed on multilocale.com and synced into the repository by the multilocale CLI",
  "license": "MIT",
  "repository": "github:multilocale/gatsby-multi-language-website-example",
  "homepage": "https://www.multilocale.com",
  "author": "Multilocale",
  "engines": {
    "node": ">=20.0.0 <26"
  },
  "scripts": {
    "build": "gatsby build",
    "clean": "gatsby clean",
    "develop": "gatsby develop",
    "serve": "gatsby serve",
    "start": "gatsby develop",
    "translations:download": "multilocale download",
    "translations:import": "multilocale import",
    "translations:unused": "multilocale unused",
    "verify": "node scripts/verifyBuild.mjs"
  },
  "keywords": [
    "gatsby",
    "i18n",
    "internationalization",
    "localization",
    "multi-language",
    "multilingual",
    "multilocale",
    "react-i18next",
    "hreflang"
  ],
  "dependencies": {
    "gatsby": "5.16.1",
    "gatsby-plugin-sitemap": "6.16.0",
    "gatsby-source-filesystem": "5.16.0",
    "gatsby-transformer-remark": "6.16.0",
    "i18next": "26.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11"
  },
  "devDependencies": {
    "multilocale": "^1.3.1"
  }
}
